# APNI DUKAN - Environment Configuration Example

# Django Backend Settings
SECRET_KEY=django-insecure-apni-dukan-production-grade-secret-key-change-in-prod
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Database Configuration (Defaults to SQLite in local dev if POSTGRES_DB is empty)
POSTGRES_DB=apnidukan_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# CORS & Frontend Origins
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# JWT Authentication
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# Redis & Celery (Optional for background tasks)
REDIS_URL=redis://localhost:6379/0

# Frontend Environment Variables (Vite)
VITE_API_BASE_URL=http://localhost:8000/api/v1
